# Copy thành .env trên server rồi điền giá trị thật.
# docker compose tự đọc file .env ở cùng thư mục với docker-compose.yml.

# MySQL root password (dùng cho cả DB và datasource của backend)
MYSQL_ROOT_PASSWORD=password

# ActiveMQ web console
ACTIVEMQ_ADMIN_LOGIN=admin
ACTIVEMQ_ADMIN_PASSWORD=admin

# GitHub Actions secrets (không nằm trong file này):
#   SERVER_HOST, SERVER_USER, SERVER_SSH_KEY
