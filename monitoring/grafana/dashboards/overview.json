{
  "uid": "rental-overview",
  "title": "Host and Rental Manager",
  "tags": ["prometheus", "rental-manager"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "15s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Host CPU usage (%)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [{ "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])))", "refId": "A" }]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Host memory usage (%)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [{ "expr": "100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)", "refId": "A" }]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Backend HTTP requests / second",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [{ "expr": "sum(rate(http_server_requests_seconds_count{application=\"rental-management\"}[5m]))", "refId": "A" }]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Backend JVM heap used (bytes)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [{ "expr": "sum(jvm_memory_used_bytes{application=\"rental-management\", area=\"heap\"})", "refId": "A" }]
    }
  ]
}
